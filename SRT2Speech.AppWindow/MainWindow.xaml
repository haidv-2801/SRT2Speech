<Window x:Class="SRT2Speech.AppWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SRT2Speech.AppWindow"
        mc:Ignorable="d"
        Title="SRT2Speech"
        Height="768"
        Width="1024">
    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Trợ giúp">
                <MenuItem Header="_Kiểm tra cập nhật..."
                          Click="MenuItemCheckUpdate_Click"
                          InputGestureText="Ctrl+U">
                    <MenuItem.Icon>
                        <TextBlock Text="🔄" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Về SRT2Speech..."
                          Click="MenuItemAbout_Click"
                          InputGestureText="F1">
                    <MenuItem.Icon>
                        <TextBlock Text="ℹ️" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>
        
        <!-- Main Content -->
        <Grid>
            <TabControl x:Name="tabControl">
            <TabItem Header="VoicemakerFpt">
                <StackPanel Orientation="Vertical"
                            Grid.IsSharedSizeScope="True">
                    <Grid Margin="10"
                          Grid.IsSharedSizeScope="True">
                        <Label Content="Chức năng không có sẵn"/>
                    </Grid>
                </StackPanel>
            </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
