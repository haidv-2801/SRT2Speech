<UserControl x:Class="SRT2Speech.AppWindow.Views.ElevenlabVoiceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SRT2Speech.AppWindow.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Resources có thể thêm vào đây nếu cần -->
    </UserControl.Resources>
    
    <DockPanel>
        <!-- File Selection and Action Buttons Section -->
        <Grid DockPanel.Dock="Top" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Row 0: File Selection -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Label Grid.Column="0"
                       Content="Select file SRT:"
                       FontSize="14"
                       VerticalContentAlignment="Center"
                       Margin="0,0,10,0"/>
                
                <TextBox Grid.Column="1"
                         x:Name="txtFile"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"
                         Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"/>
                
                <local:BaseButton Grid.Column="2"
                                 x:Name="btnOpen"
                                 Text="📄 Open File"
                                 ButtonWidth="100"
                                 ButtonHeight="32"
                                 Margin="0,0,5,0"
                                 Command="{Binding OpenFileCommand}"
                                 Tooltip="Chọn một file SRT"/>
                
                <local:BaseButton Grid.Column="3"
                                 x:Name="btnOpenFolder"
                                 Text="📁 Open Folder"
                                 ButtonWidth="110"
                                 ButtonHeight="32"
                                 Command="{Binding OpenFolderCommand}"
                                 Tooltip="Chọn thư mục chứa nhiều file SRT"/>
            </Grid>
            
            <!-- Row 1: Use Proxy Checkbox and Action Buttons -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Use Proxy Checkbox on left -->
                <CheckBox Grid.Column="0"
                          Content="Use Proxy"
                          IsChecked="{Binding UseProxy, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Margin="0,0,10,0"/>
                
                <!-- Action Buttons on right -->
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <!-- Restart App Icon Button -->
                    <local:BaseButton x:Name="btnRestartApp"
                                     Icon="🔄"
                                     ButtonWidth="32"
                                     ButtonHeight="32"
                                     IconSize="16"
                                     Margin="0,0,5,0"
                                     Command="{Binding RestartAppCommand}"
                                     Tooltip="Khởi động lại ứng dụng"/>
                    
                    <!-- Tools Menu -->
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,5,0">
                        <MenuItem Header="⚙️ Tools" Height="32" Padding="10,5" Background="#6C757D" Foreground="White" FontWeight="SemiBold">
                            <MenuItem.Resources>
                                <!-- Style cho submenu items -->
                                <Style TargetType="MenuItem">
                                    <Setter Property="Background" Value="#2D2D30"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Background" Value="#3E3E42"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="Separator">
                                    <Setter Property="Background" Value="#3E3E42"/>
                                </Style>
                            </MenuItem.Resources>
                            <MenuItem Header="🔄 Reload Config"
                                      Command="{Binding ReloadConfigCommand}"
                                      ToolTip="Reload lại file cấu hình ElevenlabConfig.yaml và ElevenlabKeyState.yaml"/>
                            <Separator/>
                            <MenuItem Header="📁 Open Output Folder"
                                      Command="{Binding OpenOutputFolderCommand}"
                                      ToolTip="Mở thư mục chứa file MP3 đã tạo"/>
                            <MenuItem Header="⚙️ Open Config Folder"
                                      Command="{Binding OpenConfigFolderCommand}"
                                      ToolTip="Mở thư mục chứa file cấu hình"/>
                            <Separator/>
                            <MenuItem Header="🔑 Load API Keys"
                                      Command="{Binding LoadApiKeysCommand}"
                                      ToolTip="Load API keys từ file text"/>
                            <MenuItem Header="📋 Copy Unavailable Keys"
                                      Command="{Binding CopyUnavailableKeysCommand}"
                                      ToolTip="Copy danh sách các API key đã không còn available vào clipboard"/>
                            <MenuItem Header="🌐 Import Proxies"
                                      Command="{Binding ImportProxiesCommand}"
                                      ToolTip="Import danh sách proxy từ file"/>
                        </MenuItem>
                    </Menu>
                
                    <local:BaseButton x:Name="btnDowload"
                                     Text="▶️ Download MP3"
                                     ButtonWidth="130"
                                     ButtonHeight="32"
                                     Margin="0,0,5,0"
                                     Command="{Binding DownloadMp3Command}"
                                     Tooltip="Bắt đầu xử lý và tải xuống file MP3"/>
                
                    <local:BaseButton x:Name="btnDowloadError"
                                     Text="🔄 Retry Errors"
                                     ButtonWidth="110"
                                     ButtonHeight="32"
                                     Command="{Binding DownloadErrorCommand}"
                                     Tooltip="Thử lại các file bị lỗi"/>
                </WrapPanel>
            </Grid>
        </Grid>
        
        <!-- Progress Section with Border -->
        <Border DockPanel.Dock="Top" 
                Margin="10,0,10,10" 
                Padding="10" 
                BorderBrush="#CCCCCC" 
                BorderThickness="1" 
                CornerRadius="4" 
                Background="#F9F9F9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <ProgressBar Grid.Row="0" 
                             Height="20" 
                             Margin="0,0,0,8"
                             Minimum="0"
                             Maximum="{Binding TotalCount, Mode=OneWay}"
                             Value="{Binding ProcessedCount, Mode=OneWay}"/>
                
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Progress: " FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ProcessedCount}"/>
                        <TextBlock Text="/" Margin="2,0"/>
                        <TextBlock Text="{Binding TotalCount}"/>
                        <TextBlock Text=" (" Margin="5,0,2,0"/>
                        <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:F1}%}"/>
                        <TextBlock Text=")"/>
                        <TextBlock Text=" | Errors: " Margin="10,0,2,0" FontWeight="SemiBold" Foreground="Red"/>
                        <TextBlock Text="{Binding ErrorCount}" Foreground="Red"/>
                        <TextBlock Text=" | " Margin="10,0"/>
                        <TextBlock Text="{Binding StatusText}"/>
                    </StackPanel>
                    
                    <local:BaseButton Grid.Column="1"
                                     x:Name="btnStop"
                                     Text="⏹️ Stop"
                                     ButtonWidth="80"
                                     ButtonHeight="28"
                                     Command="{Binding StopCommand}"/>
                </Grid>
            </Grid>
        </Border>
        
        <!-- Log Section (fills remaining space) -->
        <DockPanel Margin="10,0,10,10" LastChildFill="True">
            <Label DockPanel.Dock="Top" 
                   Content="Thông tin log:" 
                   FontSize="14" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,5"/>
            
            <RichTextBox x:Name="txtLog"
                         Background="#1E1E1E" 
                         Foreground="#D4D4D4"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         MinHeight="200"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
    </DockPanel>
</UserControl>
