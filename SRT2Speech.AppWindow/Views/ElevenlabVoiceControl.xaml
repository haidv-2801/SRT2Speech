<UserControl x:Class="SRT2Speech.AppWindow.Views.ElevenlabVoiceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SRT2Speech.AppWindow.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Button Styles -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004578"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#218838"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E7E34"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="WarningButton" TargetType="Button">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0A800"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D39E00"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C82333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#BD2130"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#6C757D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A6268"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#545B62"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <DockPanel>
        <!-- File Selection and Action Buttons Section -->
        <Grid DockPanel.Dock="Top" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Row 0: File Selection -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Label Grid.Column="0" 
                       Content="Select file SRT:" 
                       FontSize="14"
                       VerticalContentAlignment="Center"
                       Margin="0,0,10,0"/>
                
                <TextBox Grid.Column="1" 
                         x:Name="txtFile"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"
                         Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"/>
                
                <Button Grid.Column="2"
                        Content="Open"
                        Width="80"
                        Height="32"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenFileCommand}"/>
            </Grid>
            
            <!-- Row 1: Use Proxy Checkbox and Action Buttons -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Use Proxy Checkbox on left -->
                <CheckBox Grid.Column="0"
                          Content="Use Proxy"
                          IsChecked="{Binding UseProxy, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Margin="0,0,10,0"/>
                
                <!-- Action Buttons on right -->
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <!-- Restart App Icon Button -->
                    <Button x:Name="btnRestartApp"
                            Content="🔄"
                            Width="32"
                            Height="32"
                            FontSize="16"
                            Margin="0,0,5,0"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RestartAppCommand}"
                            ToolTip="Khởi động lại ứng dụng"/>
                    
                    <!-- Tools Menu -->
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,5,0">
                        <MenuItem Header="⚙️ Tools" Height="32" Padding="10,5" Background="#6C757D" Foreground="White" FontWeight="SemiBold">
                            <MenuItem.Resources>
                                <!-- Style cho submenu items -->
                                <Style TargetType="MenuItem">
                                    <Setter Property="Background" Value="#2D2D30"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Background" Value="#3E3E42"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="Separator">
                                    <Setter Property="Background" Value="#3E3E42"/>
                                </Style>
                            </MenuItem.Resources>
                            <MenuItem Header="🔄 Reload Config"
                                      Command="{Binding ReloadConfigCommand}"
                                      ToolTip="Reload lại file cấu hình ElevenlabConfig.yaml và ElevenlabKeyState.yaml"/>
                            <Separator/>
                            <MenuItem Header="📁 Open Output Folder"
                                      Command="{Binding OpenOutputFolderCommand}"
                                      ToolTip="Mở thư mục chứa file MP3 đã tạo"/>
                            <MenuItem Header="⚙️ Open Config Folder"
                                      Command="{Binding OpenConfigFolderCommand}"
                                      ToolTip="Mở thư mục chứa file cấu hình"/>
                            <Separator/>
                            <MenuItem Header="🔑 Load API Keys"
                                      Command="{Binding LoadApiKeysCommand}"
                                      ToolTip="Load API keys từ file text"/>
                            <MenuItem Header="🌐 Import Proxies"
                                      Command="{Binding ImportProxiesCommand}"
                                      ToolTip="Import danh sách proxy từ file"/>
                        </MenuItem>
                    </Menu>
                
                    <Button x:Name="btnDowload"
                            Content="▶️ Download MP3"
                            Width="130"
                            Height="32"
                            Margin="0,0,5,0"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding DownloadMp3Command}"
                            ToolTip="Bắt đầu xử lý và tải xuống file MP3"/>
                
                    <Button x:Name="btnDowloadError"
                            Content="🔄 Retry Errors"
                            Width="110"
                            Height="32"
                            Style="{StaticResource WarningButton}"
                            Command="{Binding DownloadErrorCommand}"
                            ToolTip="Thử lại các file bị lỗi"/>
                </WrapPanel>
            </Grid>
        </Grid>
        
        <!-- Progress Section with Border -->
        <Border DockPanel.Dock="Top" 
                Margin="10,0,10,10" 
                Padding="10" 
                BorderBrush="#CCCCCC" 
                BorderThickness="1" 
                CornerRadius="4" 
                Background="#F9F9F9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <ProgressBar Grid.Row="0" 
                             Height="20" 
                             Margin="0,0,0,8"
                             Minimum="0"
                             Maximum="{Binding TotalCount, Mode=OneWay}"
                             Value="{Binding ProcessedCount, Mode=OneWay}"/>
                
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Progress: " FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ProcessedCount}"/>
                        <TextBlock Text="/" Margin="2,0"/>
                        <TextBlock Text="{Binding TotalCount}"/>
                        <TextBlock Text=" (" Margin="5,0,2,0"/>
                        <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:F1}%}"/>
                        <TextBlock Text=")"/>
                        <TextBlock Text=" | Errors: " Margin="10,0,2,0" FontWeight="SemiBold" Foreground="Red"/>
                        <TextBlock Text="{Binding ErrorCount}" Foreground="Red"/>
                        <TextBlock Text=" | " Margin="10,0"/>
                        <TextBlock Text="{Binding StatusText}"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1"
                            Content="⏹️ Stop"
                            Width="80"
                            Height="28"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding StopCommand}"/>
                </Grid>
            </Grid>
        </Border>
        
        <!-- Log Section (fills remaining space) -->
        <DockPanel Margin="10,0,10,10" LastChildFill="True">
            <Label DockPanel.Dock="Top" 
                   Content="Thông tin log:" 
                   FontSize="14" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,5"/>
            
            <RichTextBox x:Name="txtLog"
                         Background="#1E1E1E" 
                         Foreground="#D4D4D4"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         MinHeight="200"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
    </DockPanel>
</UserControl>
