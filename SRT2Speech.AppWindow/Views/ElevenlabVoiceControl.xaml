<UserControl x:Class="SRT2Speech.AppWindow.Views.ElevenlabVoiceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SRT2Speech.AppWindow.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <StackPanel Orientation="Vertical">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Label FontSize="16"
                   Grid.Row="0"
                   Grid.Column="0"
                   Margin="0,0,0,10"
                   VerticalContentAlignment="Center"
                   VerticalAlignment="Center">
                Select file SRT:
            </Label>
            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Height="30"
                     Margin="10,0,0,10"
                     VerticalContentAlignment="Center"
                     VerticalAlignment="Center"
                     x:Name="txtFile"
                     Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Row="0"
                    Grid.Column="2"
                    Margin="10,0,0,10"
                    Content="Open"
                    Width="53"
                    Command="{Binding OpenFileCommand}"/>
            <Button Grid.Row="0"
                    Grid.Column="3"
                    x:Name="btnDowload"
                    Margin="10,0,0,10"
                    Content="Download MP3"
                    Width="80"
                    Command="{Binding DownloadMp3Command}"/>
            <Button Grid.Row="0"
                    Grid.Column="4"
                    x:Name="btnDowloadError"
                    Margin="10,0,0,10"
                    Content="Download MP3 Error"
                    Width="120"
                    Command="{Binding DownloadErrorCommand}"/>
            <Button Grid.Row="0"
                    Grid.Column="5"
                    x:Name="btnLoadApiKeys"
                    Margin="10,0,0,10"
                    Content="Load API Keys"
                    Width="100"
                    Command="{Binding LoadApiKeysCommand}"/>
        </Grid>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label FontSize="16"
                   Grid.Row="0"
                   Grid.Column="0"
                   VerticalContentAlignment="Center"
                   VerticalAlignment="Center">
                Thông tin log:
            </Label>
            <RichTextBox Grid.Row="1"
                          Grid.Column="0"
                          Background="Black"
                          Foreground="White"
                          x:Name="txtLog"/>
        </Grid>
    </StackPanel>
</UserControl>
